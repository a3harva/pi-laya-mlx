{"category":"routine","tool":"write","input":{"path":"src/utils/retry.ts","content":"export async function retry<T>(fn: () => Promise<T>, n = 3): Promise<T> {\n  let last: unknown;\n  for (let i = 0; i < n; i++) {\n    try {\n      return await fn();\n    } catch (e) {\n      last = e;\n      await new Promise((r) => setTimeout(r, 2 ** i * 100));\n    }\n  }\n  throw last;\n}\n"},"cwd":"/Users/alice/code/web-dashboard"}
